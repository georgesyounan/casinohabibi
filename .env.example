APP_ENV=development
DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
SECURE_COOKIES=0

# Uncomment and replace all values to enable the operator admin account.
# Keep PROVIDER_KEY_ENCRYPTION stable for this database. Generate 32 random
# bytes and store the resulting 64-character hexadecimal value privately.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.ca
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-chars
# PROVIDER_KEY_ENCRYPTION=replace-with-64-hex-characters

# Optional platform onboarding API secret (minimum 32 characters).
# PLATFORM_ADMIN_TOKEN=replace-with-a-private-token-of-at-least-32-chars

# Optional in development. Without these settings, reset links are shown in
# the server console and the returned URL is for local development only.
# RESET_EMAIL_API_KEY=re_...
# RESET_EMAIL_FROM=accounts@example.ca
# PUBLIC_BASE_URL=https://casino.example.ca
