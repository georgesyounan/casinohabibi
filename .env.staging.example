APP_ENV=staging
DATA_DIR=./data/staging
HOST=0.0.0.0
PORT=3000
SECURE_COOKIES=1

# Replace every placeholder before starting the staging service.
BOOTSTRAP_ADMIN_EMAIL=staging-admin@example.ca
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-chars
PROVIDER_KEY_ENCRYPTION=replace-with-64-hex-characters
PLATFORM_ADMIN_TOKEN=replace-with-a-private-token-of-at-least-32-chars
RESET_EMAIL_API_KEY=replace-with-a-private-Resend-key
RESET_EMAIL_FROM=accounts@example.ca
PUBLIC_BASE_URL=https://staging.example.ca
